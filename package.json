{
  "name": "@johnpiapian/grit",
  "version": "2026.10.29-alpha",
  "description": "A simple CLI tool built with Bun",
  "author": "Sut Tuang - @johnpiapian",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist && mkdir -p dist",
    "clean:cli": "rm -rf dist/cli && mkdir -p dist/cli",
    "clean:web": "rm -rf dist/web && mkdir -p dist/web/public",
    "dev": "bun run --watch src/cli-entry.ts",
    "dev:web": "bun run src/web-server.ts",
    "start": "bun run src/cli-entry.ts",
    "start:web": "bun run src/web-server.ts",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format --check .",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write .",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test",
    "build": "bun run clean && bun run build:cli && bun run build:web",
    "build:cli": "bun run clean:cli && bun build src/cli-entry.ts --outfile dist/cli/index.js --target bun",
    "build:web": "bun run clean:web && bun build src/web-server.ts --outfile dist/web/server.js --target bun && cp -R public dist/web/public",
    "build:pages": "rm -rf dist && mkdir -p dist && cp -R public dist && cp -R src dist/src",
    "build:standalone": "bun build src/cli-entry.ts --compile --outfile dist/cli/grit",
    "prepack": "bun run build",
    "package": "bun pm pack"
  },
  "files": [
    "dist/cli"
  ],
  "bin": {
    "grit": "dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnpiapian/grit.git"
  },
  "keywords": [
    "bun",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/johnpiapian/grit/issues"
  },
  "homepage": "https://github.com/johnpiapian/grit#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
